# Application Secret (required)
# Generate a secure random string for production
# Use command: openssl rand -hex 32
APP_SECRET=your-secure-secret-here

# Supabase Postgres
# Runtime: use the Transaction pooler (port 6543) on Vercel
# CLI/migrations: use the Direct or Session pooler URL (port 5432)
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Also accepted on Vercel if you use the Supabase integration:
# POSTGRES_URL, POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING

# Better-Auth Configuration (required)
# Generate a secure secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-better-auth-secret-here
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000
